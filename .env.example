# --- Baza (Supabase Postgres) ---
# Aplikacija: "Transaction pooler" konekcija (port 6543) iz Supabase → Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Migracije i seed: "Session pooler" ili direktna konekcija (port 5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Admin panel ---
# Hash napravi sa: npm run admin:hash   (lozinka se nikad ne upisuje ovde u čistom obliku)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:...

# --- Wialon (opciono) ---
# Bez tokena mapa radi u režimu simulacije.
# WIALON_TOKEN=
# Za Wialon Local upiši svoj host; podrazumevano je Wialon Hosting.
# WIALON_HOST=https://hst-api.wialon.com
